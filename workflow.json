              "name": "telegramMessage",
              "value": "={{ `Что я сделал \n\n${$json.review.summary}  \n\nЧто я узнал\n\n${$json.review.learned.map(item => \n`• ${item}`).join('\\n')} \n\nКак я это понял\n\n${$json.review.explanation} \n\nПример\n\n\\`\\`\\`\n${$json.review.example || 'Пример не нужен'}\n\\`\\`\\`\n\nCommit\n\nhttps://github.com/YOUR_GITHUB_USER/YOUR_REPO/commit/${$('Edit Fields3').item.json.commitId}\n`\n}}",
              "type": "string"
            }
          ]
        },
        "options": {}
